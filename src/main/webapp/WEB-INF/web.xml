<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                  http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>DataONE Portal</display-name>

    <!-- load portal.properties into Settings before any servlet starts -->
    <listener>
        <listener-class>org.dataone.portal.PortalConfigListener</listener-class>
    </listener>
    
    <!-- ensure session lasts as long as a token (18 hours, TokenGenerator's default TTL) -->
    <session-config>
    	<session-timeout>1080</session-timeout>
    	<!-- SameSite=None is added by the CN's Apache proxy, not here; MetacatUI's
    	     cross-site /token requests need it until they stop relying on this cookie -->
    	<cookie-config>
    		<http-only>true</http-only>
    		<secure>true</secure>
    	</cookie-config>
    	<tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!--  ORCID OAuth servlet -->
	<servlet>
		<servlet-name>oauthServlet</servlet-name>
		<servlet-class>org.dataone.portal.servlets.oauth.OrcidOAuthServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>oauthServlet</servlet-name>
		<url-pattern>/oauth</url-pattern>
	</servlet-mapping>
	
	<!--  Keycloak OpenID Connect login (/login) and callback (/authorize), named as in
	      the Python dataone-auth package -->
	<servlet>
		<servlet-name>oidcServlet</servlet-name>
		<servlet-class>org.dataone.portal.servlets.oidc.KeycloakOidcServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>oidcServlet</servlet-name>
		<url-pattern>/login</url-pattern>
		<url-pattern>/authorize</url-pattern>
	</servlet-mapping>
	
	<!--  Keycloak token refresh -->
	<servlet>
		<servlet-name>refreshServlet</servlet-name>
		<servlet-class>org.dataone.portal.servlets.oidc.KeycloakRefreshServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>refreshServlet</servlet-name>
		<url-pattern>/refresh</url-pattern>
	</servlet-mapping>
	
	<!-- token endpoint -->
	<servlet>
		<servlet-name>tokenServlet</servlet-name>
		<servlet-class>org.dataone.portal.servlets.TokenServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>tokenServlet</servlet-name>
		<url-pattern>/token</url-pattern>
	</servlet-mapping>
	
	<!-- logout endpoint -->
	<servlet>
		<servlet-name>logoutServlet</servlet-name>
		<servlet-class>org.dataone.portal.servlets.LogoutServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>logoutServlet</servlet-name>
		<url-pattern>/logout</url-pattern>
	</servlet-mapping>
    
	<!-- NOTE: can override the CN URL for DataONE -->
	<context-param>
		<param-name>D1Client.CN_URL</param-name>
		<param-value>https://cn.dataone.org/cn</param-value>
	</context-param>
	<!-- properties file to augment additional properties -->
	<context-param>
        <param-name>portal.properties.file</param-name>
        <param-value>/var/lib/tomcat7/webapps/portal/WEB-INF/portal.properties</param-value>
    </context-param>
	
</web-app>
